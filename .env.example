# One .env for the whole repo: copy this file to .env in the repo root.
# - worker: reads it at startup
# - web: next.config.mjs loads it (apps/web/.env.local still works as an override)
# - Convex functions: `npm run dev` (or `npm run env:sync`) copies the keys
#   they use (LLM_*, GITHUB_*, PROVIDER_ENCRYPTION_KEY, CONVEX_SERVICE_TOKEN)
#   to the Convex deployment, only when a value changed.
# MOAgent — root .env (read by the worker at startup and by `npm run doctor`).
# cp .env.example .env   then run `npm run doctor`.
# The web app reads apps/web/.env.local and the Convex CLI apps/api/.env.local
# (see the .env.example next to each). Settings that the Convex BACKEND reads
# (CONVEX_SERVICE_TOKEN, GITHUB_*, LLM_*, PROVIDER_ENCRYPTION_KEY,
# MOAGENT_WEEKLY_TOKEN_BUDGET) are set with `npx convex env set` — see
# apps/api/.env.example.

# --- Required ---------------------------------------------------------------
# Convex deployment URL (CONVEX_URL is accepted as a fallback by the worker).
NEXT_PUBLIC_CONVEX_URL=
# Shared secret the worker sends to Convex worker functions. Must equal the
# CONVEX_SERVICE_TOKEN in the Convex env. Generate: openssl rand -hex 32
CONVEX_SERVICE_TOKEN=

# --- LLM fallback (optional when a provider is configured in Settings → LLM) -
# anthropic | openai | openai-compatible
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Decrypts provider keys saved in Settings (AES-256-GCM). Must equal the value
# in the Convex env. Base64 of 32 bytes: openssl rand -base64 32.
# PROVIDER_ENCRYPTION_KEY_OLD is tried during a rotation.
PROVIDER_ENCRYPTION_KEY=
# PROVIDER_ENCRYPTION_KEY_OLD=

# --- GitHub OAuth (optional) -------------------------------------------------
# HMAC key for the signed, one-time OAuth `state` (GitHub connect). Falls back
# to PROVIDER_ENCRYPTION_KEY when unset. Generate: openssl rand -hex 32
# OAUTH_STATE_SECRET=
# Web app origin the OAuth popup posts its result to. Default: the origin of
# GITHUB_OAUTH_CALLBACK_URL (http://localhost:3000 when that is unset).
# APP_ORIGIN=https://moagent.example.com

# --- GitHub webhooks (optional) ----------------------------------------------
# Fallback secret for GitHub webhook signatures (X-Hub-Signature-256) when a
# project has not generated its own in Integrations. Without either, webhook
# deliveries are rejected with 401. Generate: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=

# --- Worker -----------------------------------------------------------------
WORKSPACE_ROOT=./workspaces
WORKER_POLL_INTERVAL_MS=2000
# WORKER_ID=                         # default <hostname>-<pid>
# WORKER_CONCURRENCY=1
# WORKER_LEASE_MS=60000
# WORKER_HEARTBEAT_MS=10000
# WORKER_LLM_MAX_CONCURRENCY=        # worker-wide LLM call bound

# --- LLM calls --------------------------------------------------------------
# ORCHESTRATOR_LLM_MAX_TOKENS=8192    # max output tokens per call
# ORCHESTRATOR_LLM_TIMEOUT_MS=300000  # ceiling for one LLM request

# --- Task limits ------------------------------------------------------------
# ORCHESTRATOR_SUBTASK_TIMEOUT_MS=300000       # low/medium tasks
# ORCHESTRATOR_SUBTASK_TIMEOUT_HIGH_MS=900000  # high/ultra tasks
# ORCHESTRATOR_TASK_TIMEOUT_MS=1200000         # low/medium tasks (20 min)
# ORCHESTRATOR_TASK_TIMEOUT_HIGH_MS=2400000    # high/ultra tasks (40 min)
# ORCHESTRATOR_APPROVAL_TIMEOUT_MS=1800000
# ORCHESTRATOR_SUBTASK_RETRIES=1
# ORCHESTRATOR_MAX_REPLANS=1
# ORCHESTRATOR_MAX_TOKEN_BUDGET_PER_TASK=2000000
# ORCHESTRATOR_BUDGET_MODE=          # "enforce" = hard stop at the token budget
# ORCHESTRATOR_REVIEW_MODE=auto      # always | auto | never
# ORCHESTRATOR_VERIFICATION_ENABLED=1
# ORCHESTRATOR_VERIFICATION_BUILD=1
# ORCHESTRATOR_WORKTREE_ISOLATION=0

# --- Execution runtime (OpenCode) ------------------------------------------
# Global default: "api" (agent LLM + MOAgent host tools, gated) or "opencode"
# (OpenCode CLI runs its own tools in the task worktree; changes still pass
# the staging gate). An agent's own Runtime setting (web agent form)
# overrides this. Legacy name ORCHESTRATOR_RUNTIME is still read.
ORCHESTRATOR_EXECUTION_RUNTIME=api
# OpenCode CLI binary (npm i -g opencode-ai).
ORCHESTRATOR_NATIVE_PROVIDER_COMMAND=opencode
# Wall-clock limit per OpenCode run (ms); the process tree is killed after it.
# ORCHESTRATOR_NATIVE_TIMEOUT_MS=600000
# Without an agent OpenCode model, OpenCode is pointed at the agent's resolved
# MOAgent LLM (provider pool or LLM_* env) via a temporary config; the key
# travels only in the child env.

# --- Browser QA -------------------------------------------------------------
# Default mode is auto: QA runs for applied UI changes (or when the user asks
# for QA/e2e) in a browser-runnable project.
# Install Chromium once: cd packages/worker && npx playwright install chromium
ORCHESTRATOR_QA_MODE=auto
# ORCHESTRATOR_QA_MAX_FIX_ITERATIONS=1
# ORCHESTRATOR_QA_REQUIRED=0        # 1 = environment-blocked QA fails the task
# Workload Manager: prefer the capable agent with spare capacity when the
# project has no loadAwareRouting setting (default off).
# ORCHESTRATOR_LOAD_AWARE_ROUTING=0
# QA_STARTUP_TIMEOUT_MS=90000        # dev-server startup wait
# QA_CHROMIUM_PATH=                  # system Chromium (e.g. linux-arm64), fallback PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH
# QA_CHROMIUM_NO_SANDBOX=            # 1 = add --no-sandbox (auto when root / in a container)
