# Fhara — one .env for the whole repo. Copy this file to .env in the repo root:
#   cp .env.example .env   then run `npm run doctor`.
#
# - worker: loads the root .env at startup.
# - web: next.config.mjs loads it (apps/web/.env.local still works as an override).
# - Convex functions cannot read files: `npm run dev` (or `npm run env:sync`) copies the
#   keys marked "synced to Convex" to the deployment env, only when a value changed.
# - The Convex CLI target (CONVEX_DEPLOYMENT / CONVEX_SELF_HOSTED_*) lives in
#   apps/api/.env.local; see apps/api/.env.example.
#
# GENERATED from packages/config/src/schema by `npm run env:example`; edit the schema,
# not this file. Commented lines show the default; uncommented lines must be filled in.

# --- Required ---------------------------------------------------------------
# The Convex deployment and the service token the worker, Convex and the web server share.

# Convex deployment URL (worker, web, scripts).
#   (read by: worker, web, scripts; legacy name CONVEX_URL still read)
NEXT_PUBLIC_CONVEX_URL=

# Shared service token; must be equal in the worker, Convex and the web server.
#   (read by: worker, Convex, web, scripts; synced to Convex by npm run dev; secret, generate: openssl rand -hex 32)
CONVEX_SERVICE_TOKEN=

# Convex HTTP actions URL; a Convex system var, derived from NEXT_PUBLIC_CONVEX_URL on the web side.
#   (read by: web, Convex; set by Convex itself; on the web side derived from NEXT_PUBLIC_CONVEX_URL)
# CONVEX_SITE_URL=

# AES-256-GCM key (base64, 32 bytes) for stored provider credentials; worker and Convex must match.
#   (read by: worker, Convex; synced to Convex by npm run dev; secret; base64 of 32 bytes: openssl rand -base64 32)
# PROVIDER_ENCRYPTION_KEY=

# Previous encryption key during a rotation: the Convex migration re-encrypts with it, the worker decrypts not-yet-migrated rows with it.
#   (read by: worker, Convex; synced to Convex by npm run dev; secret; base64 of 32 bytes: openssl rand -base64 32)
# PROVIDER_ENCRYPTION_KEY_OLD=

# The deployment's own URL; a Convex system var. The fixtures guard reads it to tell a local/self-hosted backend from Convex cloud.
#   (read by: Convex; set by Convex itself; on the web side derived from NEXT_PUBLIC_CONVEX_URL)
# CONVEX_CLOUD_URL=

# --- LLM fallback -----------------------------------------------------------
# Optional when a provider is configured in Settings → LLM. Used by the worker and by
# Convex (chat, prompt enhance) when no provider row applies.

# Global LLM provider fallback: anthropic | openai | openai-compatible.
#   (read by: worker, Convex, scripts; synced to Convex by npm run dev)
# LLM_PROVIDER=anthropic

# Global fallback model; the default depends on LLM_PROVIDER.
#   (read by: worker, Convex, scripts; synced to Convex by npm run dev)
# LLM_MODEL=

# Global fallback base URL; the default depends on LLM_PROVIDER.
#   (read by: worker, Convex, scripts; synced to Convex by npm run dev)
# LLM_BASE_URL=

# OpenAI-flavour base URL; wins over LLM_BASE_URL for that flavour.
#   (read by: worker, Convex; synced to Convex by npm run dev)
# LLM_OPENAI_BASE_URL=

# Anthropic-flavour base URL; wins over LLM_BASE_URL for that flavour.
#   (read by: worker, Convex; synced to Convex by npm run dev)
# LLM_ANTHROPIC_BASE_URL=

# Global fallback API key; also the default apiKeyEnv name.
#   (read by: worker, Convex, scripts; synced to Convex by npm run dev; legacy name OPENAI_API_KEY still read; secret)
# LLM_API_KEY=

# How many calls in a row one provider serves before the round robin moves on.
#   (read by: worker)
# LLM_ROUND_ROBIN_STICKY_LIMIT=1

# Max output tokens per LLM call.
#   (read by: worker)
# ORCHESTRATOR_LLM_MAX_TOKENS=8192

# Ceiling for one LLM request (ms).
#   (read by: worker)
# ORCHESTRATOR_LLM_TIMEOUT_MS=300000

# Operator override for the Stagehand browser tool's model key.
#   (read by: worker; secret)
# STAGEHAND_API_KEY=

# Operator override for the Stagehand browser tool's model.
#   (read by: worker)
# STAGEHAND_MODEL=anthropic/claude-sonnet-4-20250514

# --- GitHub OAuth and webhooks (Convex) -------------------------------------
# GitHub OAuth app for push / draft PRs, the signed OAuth state, and the fallback
# webhook secret (per-project secrets from Integrations win; none = webhooks 401).
# The GitHub token is stored encrypted, so connecting GitHub needs PROVIDER_ENCRYPTION_KEY.

# GitHub OAuth app client id.
#   (read by: Convex, scripts; synced to Convex by npm run dev)
# GITHUB_CLIENT_ID=

# GitHub OAuth app client secret.
#   (read by: Convex, scripts; synced to Convex by npm run dev; secret)
# GITHUB_CLIENT_SECRET=

# OAuth callback URL (default http://localhost:3000/api/integrations/github/callback).
#   (read by: Convex; synced to Convex by npm run dev)
# GITHUB_OAUTH_CALLBACK_URL=

# Fallback webhook secret; without one webhooks answer 401.
#   (read by: Convex; synced to Convex by npm run dev; secret, generate: openssl rand -hex 32)
# GITHUB_WEBHOOK_SECRET=

# HMAC secret for OAuth state; falls back to PROVIDER_ENCRYPTION_KEY.
#   (read by: Convex; synced to Convex by npm run dev; secret, generate: openssl rand -hex 32)
# OAUTH_STATE_SECRET=

# Web app origin; defaults to the origin of GITHUB_OAUTH_CALLBACK_URL.
#   (read by: Convex; synced to Convex by npm run dev)
# APP_ORIGIN=

# --- Usage meter (Convex) ---------------------------------------------------

# Weekly token budget for the usage meter; unset = meter off.
#   (read by: Convex; synced to Convex by npm run dev)
# MOAGENT_WEEKLY_TOKEN_BUDGET=0

# --- Web server exposure ----------------------------------------------------
# The web UI's /api routes have no login. `npm run dev` / `start` bind to 127.0.0.1, and
# /api/* only answers requests whose Host is localhost/127.0.0.1/[::1] and (for writes)
# whose Origin is the UI itself.

# Host the Next launcher binds (scripts/next.mjs).
#   (read by: scripts)
# FHARA_HOST=127.0.0.1

# Extra Host headers the API guard accepts (comma-separated).
#   (read by: web)
# FHARA_ALLOWED_HOSTS=

# 1 lets the web API register local (stdio) MCP servers.
#   (read by: web)
# FHARA_ALLOW_LOCAL_MCP=0

# 1 also binds the dev server to this machine's Tailscale address.
#   (read by: scripts)
# FHARA_BIND_TAILSCALE=0

# --- Worker process ---------------------------------------------------------

# Worker poll interval (ms).
#   (read by: worker)
# WORKER_POLL_INTERVAL_MS=1500

# Fallback poll while the pendingWork subscription is live (ms; never below the poll interval).
#   (read by: worker)
# WORKER_FALLBACK_POLL_MS=10000

# Worker heartbeat interval (ms).
#   (read by: worker)
# WORKER_HEARTBEAT_MS=10000

# Task lease length (ms).
#   (read by: worker)
# WORKER_LEASE_MS=60000

# Tasks one worker runs at once.
#   (read by: worker)
# WORKER_CONCURRENCY=1

# Grace before a lease-less running task counts as stale (ms).
#   (read by: worker)
# WORKER_STALE_GRACE_MS=30000

# How often an idle worker checks for approved push requests (ms).
#   (read by: worker)
# WORKER_PUSH_POLL_MS=5000

# How often an idle worker checks for MCP Test connection requests (ms).
#   (read by: worker)
# WORKER_MCP_TEST_POLL_MS=3000

# Idle poll for grounded chat repo-tool requests (ms).
#   (read by: worker)
# WORKER_REPO_TOOL_POLL_MS=1000

# How often the worker checks whether the OpenCode model catalog needs a refresh (ms).
#   (read by: worker)
# WORKER_OPENCODE_CATALOG_POLL_MS=15000

# Host pressure gate (G10): 0 turns it off. While memory, disk or load is critical the worker defers new task claims (they stay queued).
#   (read by: worker)
# WORKER_PRESSURE_GATE=1

# Memory used (%) that counts as critical; warn is 10 points lower (0 = memory never trips).
#   (read by: worker)
# WORKER_PRESSURE_MEMORY_PCT=95

# Workspace disk used (%) that counts as critical, only together with WORKER_PRESSURE_DISK_GIB; warn is 5 points lower (0 = disk never trips).
#   (read by: worker)
# WORKER_PRESSURE_DISK_PCT=95

# Workspace disk free (GiB) at or below which disk counts as critical, only together with WORKER_PRESSURE_DISK_PCT; warn is 3x this.
#   (read by: worker)
# WORKER_PRESSURE_DISK_GIB=2

# 1-minute load per CPU (%, 400 = 4 per core) that counts as critical; warn is 75% of it (0 = load never trips).
#   (read by: worker)
# WORKER_PRESSURE_LOAD_PCT=400

# Worker id; defaults to <hostname>-<pid> (supplied by the worker).
#   (read by: worker)
# WORKER_ID=

# 0 turns off the websocket wake-up subscription (poll only).
#   (read by: worker)
# WORKER_SUBSCRIBE=1

# Worker-wide LLM gate; falls back to ORCHESTRATOR_MAX_CONCURRENT_LLM_CALLS, then 1.
#   (read by: worker; legacy name ORCHESTRATOR_MAX_CONCURRENT_LLM_CALLS still read)
# WORKER_LLM_MAX_CONCURRENCY=1

# 0 turns off memory suggestions after a task.
#   (read by: worker)
# FHARA_MEMORY_SUGGESTIONS=1

# 0 turns off role memory (per-role learnings) for every project.
#   (read by: worker)
# FHARA_ROLE_MEMORY=1

# Fhara MCP server (GOAT G12a): the port it listens on, on 127.0.0.1 only (0 = off). Starts only when FHARA_MCP_TOKEN is set too.
#   (read by: worker)
# FHARA_MCP_PORT=0

# Bearer token every Fhara MCP request must carry (Authorization: Bearer <token>); at least 16 characters, else the server stays off.
#   (read by: worker; secret)
# FHARA_MCP_TOKEN=

# Fhara MCP completion webhook (GOAT G12b): http(s) URL that gets a signed POST when a run.report_result is recorded. Blank = off; needs FHARA_MCP_WEBHOOK_SECRET.
#   (read by: worker)
# FHARA_MCP_WEBHOOK_URL=

# HMAC-SHA256 key for the completion webhook (X-Fhara-Signature: sha256=<hex> over "<X-Fhara-Timestamp>.<body>"); at least 16 characters, else the webhook stays off.
#   (read by: worker; secret)
# FHARA_MCP_WEBHOOK_SECRET=

# --- Direct chat threads (worker) -------------------------------------------

# Direct-thread poll interval (ms).
#   (read by: worker)
# DIRECT_POLL_MS=750

# Minutes before an idle direct thread is closed.
#   (read by: worker)
# DIRECT_IDLE_MIN=10

# Max live direct threads (agent sessions) per worker (1–8). At the cap, a new thread releases the oldest idle session, which resumes on its next message; a thread with a turn running or waiting on an approval is never released.
#   (read by: worker)
# DIRECT_MAX_LIVE=4

# api-loop forces the API loop engine; auto prefers OpenCode ACP.
#   (read by: worker; one of: api-loop | auto)
# DIRECT_ENGINE=auto

# Turn watchdog: minutes with no frame at all from the ACP agent before the turn is stopped as timed out (0 = off). Generous: a slow model can think for several minutes between frames.
#   (read by: worker)
# DIRECT_INACTIVITY_MIN=20

# Turn watchdog: minutes with no real progress (text, tool or plan updates; heartbeats don't count) before the turn is stopped as timed out (0 = off).
#   (read by: worker)
# DIRECT_PROGRESS_MIN=30

# Turn watchdog: a turn waiting on an approval card is exempt for up to this many minutes (0 = no cap). Kept at least DIRECT_APPROVAL_MAX_MIN + 1, so the card expires first; this is only the backstop.
#   (read by: worker)
# DIRECT_WATCHDOG_APPROVAL_MIN=60

# Minutes an approval card in a direct thread waits for an answer. Unanswered past this, the card expires (reason expired), the agent is told no and the turn goes on.
#   (read by: worker)
# DIRECT_APPROVAL_MAX_MIN=30

# --- Task limits and orchestration (worker) ---------------------------------
# With ORCHESTRATOR_WORKTREE_ISOLATION on, up to ORCHESTRATOR_PARALLEL_DEFAULT non-conflicting
# subtasks run side by side; without it the default is 1. Agent Reach (read-only public web):
#   uv tool install https://github.com/Panniantong/Agent-Reach/releases/latest/download/agent-reach.zip

# Max replans per task (0–3).
#   (read by: worker)
# ORCHESTRATOR_MAX_REPLANS=1

# Run each task in its own git worktree.
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_WORKTREE_ISOLATION=0

# Default parallel DAG nodes when worktree isolation is on (1–3).
#   (read by: worker)
# ORCHESTRATOR_PARALLEL_DEFAULT=2

# Max subtasks per plan (1–20).
#   (read by: worker)
# ORCHESTRATOR_MAX_SUBTASKS=8

# Max subtasks running at once (1–8); defaults to the parallel default.
#   (read by: worker)
# ORCHESTRATOR_MAX_CONCURRENCY=

# Planning iteration bound (0–3); defaults to ORCHESTRATOR_MAX_REPLANS.
#   (read by: worker)
# ORCHESTRATOR_MAX_PLANNING_ITERATIONS=

# Max review fix rounds (0–5).
#   (read by: worker)
# ORCHESTRATOR_MAX_REVIEW_ITERATIONS=2

# Subtask timeout (ms); when set explicitly the runner does not grow it from observed latency.
#   (read by: worker)
# ORCHESTRATOR_SUBTASK_TIMEOUT_MS=900000

# Subtask timeout for high/ultra complexity tasks (ms); default max(900000, ORCHESTRATOR_SUBTASK_TIMEOUT_MS).
#   (read by: worker)
# ORCHESTRATOR_SUBTASK_TIMEOUT_HIGH_MS=

# Retries per failed subtask (0–3).
#   (read by: worker)
# ORCHESTRATOR_SUBTASK_RETRIES=1

# How long a pending approval waits (ms).
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_APPROVAL_TIMEOUT_MS=1800000

# Live task deadline (ms).
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_TASK_TIMEOUT_MS=1200000

# Task deadline for high/ultra complexity tasks (ms); default max(2400000, ORCHESTRATOR_TASK_TIMEOUT_MS).
#   (read by: worker)
# ORCHESTRATOR_TASK_TIMEOUT_HIGH_MS=

# Abort a task after this long without observable progress (ms).
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_IDLE_TIMEOUT_MS=600000

# Planner-call stall watchdog (ms, 0 = off).
#   (read by: worker)
# ORCHESTRATOR_PLANNING_STALL_MS=720000

# Run verification after code changes.
#   (read by: worker)
# ORCHESTRATOR_VERIFICATION_ENABLED=1

# Include the build in verification.
#   (read by: worker)
# ORCHESTRATOR_VERIFICATION_BUILD=1

# Verification timeout (ms; can only be lowered).
#   (read by: worker)
# ORCHESTRATOR_VERIFICATION_TIMEOUT_MS=300000

# Max agents per task (1–10).
#   (read by: worker)
# ORCHESTRATOR_MAX_AGENTS_PER_TASK=3

# LLM call budget per task (1–1000).
#   (read by: worker)
# ORCHESTRATOR_MAX_LLM_CALLS_PER_TASK=400

# Max delegation chain depth (0–10).
#   (read by: worker)
# ORCHESTRATOR_MAX_DELEGATION_DEPTH=2

# Max approved delegations per task (0–100).
#   (read by: worker)
# ORCHESTRATOR_MAX_DELEGATIONS=10

# Budget exhaustion: warn (default) or enforce.
#   (read by: worker; one of: warn | enforce)
# ORCHESTRATOR_BUDGET_MODE=warn

# Per-task LLM gate (1–8); defaults to the parallel default.
#   (read by: worker)
# ORCHESTRATOR_MAX_CONCURRENT_LLM_CALLS=

# Token budget per task.
#   (read by: worker)
# ORCHESTRATOR_MAX_TOKEN_BUDGET_PER_TASK=2000000

# Let routing fall back to the top agent when no agent serves a capability.
#   (read by: worker)
# ORCHESTRATOR_ALLOW_FALLBACK=0

# The orchestrator's plan and decisions are the ones executed.
#   (read by: worker)
# ORCHESTRATOR_AUTHORITATIVE=1

# When the intent router consults the LLM advisor.
#   (read by: worker; one of: off | ambiguous | always; also set in Settings (overrides this file))
# ORCHESTRATOR_ROUTER_LLM=off

# Max agents answering one chat message (1–5).
#   (read by: worker)
# ORCHESTRATOR_CHAT_MAX_AGENTS=1

# When the decision engine consults the LLM advisor.
#   (read by: worker; one of: off | ambiguous | always; also set in Settings (overrides this file))
# ORCHESTRATOR_DECISION_LLM=ambiguous

# Max decision steps per task run (1–200).
#   (read by: worker)
# ORCHESTRATOR_MAX_DECISION_STEPS=20

# Labs: dynamic tool discovery for research/audit agents.
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_TOOL_LOOP=0

# Read-only agents may use discovered MCP tools mid-task.
#   (read by: worker)
# ORCHESTRATOR_MCP_TOOL_LOOP=1

# Allow MCP write tools (otherwise filtered for every role).
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_MCP_WRITE_TOOLS=0

# MCP tool-loop rounds per subtask (1–20).
#   (read by: worker)
# ORCHESTRATOR_MCP_MAX_TOOL_ITERATIONS=6

# Per-MCP-request timeout (ms).
#   (read by: worker)
# ORCHESTRATOR_MCP_TIMEOUT_MS=30000

# Cap on one MCP tool result (chars).
#   (read by: worker)
# ORCHESTRATOR_MCP_MAX_RESULT_CHARS=8000

# Agent Reach web tool for agents that declare web_reach.
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_AGENT_REACH_ENABLED=1

# Agent Reach binary.
#   (read by: worker)
# ORCHESTRATOR_AGENT_REACH_COMMAND=agent-reach

# Wall-clock limit per Agent Reach call (ms).
#   (read by: worker)
# ORCHESTRATOR_AGENT_REACH_TIMEOUT_MS=60000

# Items one Agent Reach call returns (1–20).
#   (read by: worker)
# ORCHESTRATOR_AGENT_REACH_MAX_ITEMS=10

# Agent Reach tool-loop rounds (1–20).
#   (read by: worker)
# ORCHESTRATOR_AGENT_REACH_MAX_TOOL_ITERATIONS=4

# When a review node is added for a code change.
#   (read by: worker; one of: always | auto | never)
# ORCHESTRATOR_REVIEW_MODE=auto

# When a browser QA node is added for a code change.
#   (read by: worker; one of: always | auto | never; also set in Settings (overrides this file))
# ORCHESTRATOR_QA_MODE=auto

# Max automatic QA fix rounds (0–5); falls back to the legacy QA_MAX_FIX_ITERATIONS.
#   (read by: worker)
# ORCHESTRATOR_QA_MAX_FIX_ITERATIONS=

# An environment-blocked QA run fails the task; falls back to the legacy QA_REQUIRED.
#   (read by: worker, scripts; also set in Settings (overrides this file))
# ORCHESTRATOR_QA_REQUIRED=

# Load-aware routing default when the project has none.
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_LOAD_AWARE_ROUTING=0

# Performance routing default when the project has none.
#   (read by: worker; also set in Settings (overrides this file))
# ORCHESTRATOR_PERFORMANCE_ROUTING=0

# --- Execution runtime (OpenCode) and child processes -----------------------
# OpenCode CLI: npm i -g opencode-ai. Child processes (OpenCode, run_command, QA dev servers,
# verification, MCP stdio servers, git) get an allowlisted env only (PATH, HOME, LANG/LC_*, TERM,
# TMPDIR, NODE_ENV, CI, proxy/CA vars); worker secrets are never forwarded.

# Global execution runtime: api (default) or native-provider (alias opencode).
#   (read by: worker, scripts; one of: api | native-provider; legacy name ORCHESTRATOR_RUNTIME still read)
# ORCHESTRATOR_EXECUTION_RUNTIME=api

# OpenCode (native provider) binary.
#   (read by: worker, scripts)
# ORCHESTRATOR_NATIVE_PROVIDER_COMMAND=opencode

# Wall-clock limit for one OpenCode run (ms).
#   (read by: worker)
# ORCHESTRATOR_NATIVE_TIMEOUT_MS=600000

# 1 lets OpenCode run in the project checkout without worktree isolation.
#   (read by: worker)
# ORCHESTRATOR_OPENCODE_ALLOW_UNISOLATED=0

# How long a pending command approval waits before it counts as declined (ms, ≥ 10000).
#   (read by: worker)
# ORCHESTRATOR_COMMAND_APPROVAL_TIMEOUT_MS=600000

# How long a show_options review waits for the user's pick before the agent continues without it (ms, ≥ 60000).
#   (read by: worker)
# ORCHESTRATOR_OPTIONS_REVIEW_TIMEOUT_MS=7200000

# Agent stall window (ms, 0 = off); default is the LLM timeout plus a minute.
#   (read by: worker)
# ORCHESTRATOR_STALL_TIMEOUT_MS=

# Retries after a stall (0–3).
#   (read by: worker)
# ORCHESTRATOR_STALL_RETRIES=1

# Identical consecutive outputs that stop a fix loop (2–10).
#   (read by: worker)
# ORCHESTRATOR_REPEAT_OUTPUT_LIMIT=2

# 0 turns off the verification baseline run (heuristic only).
#   (read by: worker)
# ORCHESTRATOR_VERIFY_BASELINE=1

# 0 turns off the repo map in agent prompts.
#   (read by: worker)
# REPO_MAP=1

# Repo map budget (chars, ≥ 200).
#   (read by: worker)
# REPO_MAP_MAX_CHARS=4000

# Repo map cache directory (default ~/.fhara/cache).
#   (read by: worker)
# FHARA_CACHE_DIR=

# Persistent OpenCode cache (default <tmp>/fhara-opencode-cache).
#   (read by: worker)
# FHARA_OPENCODE_CACHE_DIR=

# 0 turns off LLM-written commit messages.
#   (read by: worker)
# FHARA_COMMIT_MESSAGE_LLM=1

# 0 turns off the OpenCode permission-policy check before a run.
#   (read by: worker)
# FHARA_OPENCODE_VERIFY_POLICY=1

# Extra parent env names forwarded to spawned processes (comma-separated).
#   (read by: worker, Convex; not synced to Convex: names worker-machine vars; a Convex node action has its own env)
# FHARA_CHILD_ENV_PASSTHROUGH=

# Tool output over this many tokens (chars/4) is saved to a spill file; the model sees head + tail and reads the rest by range (0 = off).
#   (read by: worker)
# TOOL_RESULT_MAX_TOKENS=4096

# Spill files for large tool output, outside every worktree (default ~/.fhara/spill).
#   (read by: worker)
# FHARA_SPILL_DIR=

# Hours a task's spill files are kept (swept at worker start and hourly).
#   (read by: worker)
# FHARA_SPILL_RETENTION_HOURS=72

# Agent commands run in a bwrap sandbox (Linux): workspace-write (default; the worktree and extra roots are writable, /tmp is private), read-only, or off (explicit opt-out). A non-off mode without a usable bwrap reports SANDBOX_UNAVAILABLE and asks before running a command unconfined. Unset on macOS/Windows means off.
#   (read by: worker; one of: workspace-write | read-only | off)
# SANDBOX_MODE=workspace-write

# Extra absolute directories a sandboxed command may write (comma-separated), e.g. a shared build cache.
#   (read by: worker)
# SANDBOX_EXTRA_WRITE_ROOTS=

# --- Source control, pull requests and auto-merge ---------------------------

# Commit author name.
#   (read by: worker, Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# FHARA_GIT_AUTHOR_NAME=Fhara

# Commit author email.
#   (read by: worker, Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# FHARA_GIT_AUTHOR_EMAIL=fhara@users.noreply.github.com

# Allow force pushes from agent tools.
#   (read by: worker; also set in Settings (overrides this file))
# FHARA_ALLOW_FORCE_PUSH=0

# Allow pushes to the base branch from agent tools.
#   (read by: worker; also set in Settings (overrides this file))
# FHARA_ALLOW_BASE_BRANCH_PUSH=0

# Open pull requests as drafts.
#   (read by: worker; also set in Settings (overrides this file))
# FHARA_PR_DRAFT=1

# Automatic PR-feedback fix attempts (0–20).
#   (read by: Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# FHARA_PR_FIX_MAX_ATTEMPTS=3

# Supervised auto-merge: max diff lines.
#   (read by: Convex; also set in Settings (overrides this file); not synced to Convex: a Settings knob read by Convex; the stored value is the normal path)
# FHARA_AUTO_MERGE_MAX_LINES=400

# Supervised auto-merge: globs that always need a human (comma-separated).
#   (read by: Convex; also set in Settings (overrides this file); not synced to Convex: a Settings knob read by Convex; the stored value is the normal path)
# FHARA_AUTO_MERGE_SENSITIVE=.github/**, **/.env*, **/*.env, **/*.pem, **/*.key, infra/**, apps/api/convex/schema.ts

# Supervised auto-merge method.
#   (read by: Convex; one of: squash | merge | rebase; also set in Settings (overrides this file); not synced to Convex: a Settings knob read by Convex; the stored value is the normal path)
# FHARA_AUTO_MERGE_METHOD=squash

# Hours a finished task's worktree is kept.
#   (read by: Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# FHARA_WORKTREE_RETENTION_HOURS=72

# --- Browser QA -------------------------------------------------------------
# Install Chromium once: cd packages/worker && npx playwright install chromium

# Fallback QA target URL for projects without a QA/dev URL.
#   (read by: worker)
# QA_BASE_URL=

# Chromium binary for browser QA (falls back to PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH, then Playwright's own).
#   (read by: worker, scripts; also set in Settings (overrides this file))
# QA_CHROMIUM_PATH=

# Chromium --no-sandbox: auto (default: on for root or in a container), 1/true = on, 0/false = off.
#   (read by: worker; also set in Settings (overrides this file))
# QA_CHROMIUM_NO_SANDBOX=

# How long QA waits for the dev server (ms).
#   (read by: worker; also set in Settings (overrides this file); legacy name QA_SERVER_START_TIMEOUT_MS still read)
# QA_STARTUP_TIMEOUT_MS=90000

# --- Context snapshots ------------------------------------------------------

# 0 turns off context snapshots.
#   (read by: worker, Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# CONTEXT_SNAPSHOTS=1

# Days a context snapshot is kept.
#   (read by: Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# FHARA_SNAPSHOT_RETENTION_DAYS=14

# --- Chat and task watchdogs (Convex) ---------------------------------------

# When an unfinished chat reply counts as stale (ms, at least 11 min).
#   (read by: Convex; also set in Settings (overrides this file); synced to Convex by npm run dev)
# CHAT_REPLY_STALE_MS=900000

# A chat reply stops when the model sends nothing for this long (ms). Covers the wait for the first byte and every gap between chunks.
#   (read by: Convex; synced to Convex by npm run dev)
# CHAT_LLM_IDLE_TIMEOUT_MS=180000

# Total cap for one streamed chat reply (ms), kept under Convex's 10 min action limit. The text so far is kept and can be continued.
#   (read by: Convex; synced to Convex by npm run dev)
# CHAT_LLM_STREAM_MAX_MS=540000

# When a running task without progress counts as stuck (ms, 0 = off).
#   (read by: Convex; synced to Convex by npm run dev)
# TASK_WATCHDOG_STUCK_MS=1800000

# --- Workspaces -------------------------------------------------------------

# Where project workspaces live; a relative path is measured from packages/worker.
#   (read by: worker, web, Convex; also set in Settings (overrides this file); not synced to Convex: a path on the worker machine; the worker sends its absolute root with each Convex call that needs it)
# WORKSPACE_ROOT=./workspaces

# --- Electron shell (npm run electron:dev) ----------------------------------

# URL the Electron shell loads.
#   (read by: electron)
# DEV_SERVER_URL=http://localhost:3000

# --- Scripts (supervise, smoke:push, catalog:build) -------------------------

# Restart cap for scripts/supervise.mjs (default unlimited).
#   (read by: scripts)
# SUPERVISE_MAX_RESTARTS=

# Grace period before supervise.mjs kills a child (ms).
#   (read by: scripts)
# SUPERVISE_GRACE_MS=10000

# owner/repo for npm run smoke:push.
#   (read by: scripts)
# FHARA_SMOKE_REPO=

# 1 tests the push through an authenticating proxy (smoke:push).
#   (read by: scripts)
# FHARA_SMOKE_PROXY_AUTH=0

# Token for smoke:push; falls back to GITHUB_TOKEN, then GH_TOKEN.
#   (read by: scripts; legacy names GITHUB_TOKEN, GH_TOKEN still read; secret)
# FHARA_SMOKE_GITHUB_TOKEN=

# GitHub token for build-skill-catalog and smoke:push (never forwarded to children by default).
#   (read by: scripts; secret)
# GITHUB_TOKEN=

# gh CLI token; smoke:push fallback.
#   (read by: scripts; secret)
# GH_TOKEN=

# 1 allows fixtures:seed / fixtures:wipe on a non-local Convex deployment (dev only; local and self-hosted need no flag).
#   (read by: Convex, scripts; not synced to Convex: dev-only opt-in for fixtures:seed / fixtures:wipe on a non-local deployment; set it by hand with npx convex env set)
# FHARA_FIXTURES=0

# Self-hosted Convex backend URL used by the Convex CLI (fixtures:seed targets it when set).
#   (read by: scripts)
# CONVEX_SELF_HOSTED_URL=

# Convex CLI deployment selector ("local:…", "anonymous:…", "dev:…"); fixtures:seed refuses a cloud one without FHARA_FIXTURES=1.
#   (read by: scripts)
# CONVEX_DEPLOYMENT=

# Port of npm run mock:llm (0 = any free port).
#   (read by: scripts)
# MOCK_LLM_PORT=3399

# Replay speed of the mock LLM stream: 1 = 30 Hz chunks, 10 = ten times faster, 0 = no delay.
#   (read by: scripts)
# MOCK_LLM_SPEED=1

# Path of the mock LLM script (JSON rules); default scripts/mock-llm/scripts/default.json.
#   (read by: scripts)
# MOCK_LLM_SCRIPT=

# --- Legacy names (still read, do not use in new setups) --------------------
# CONVEX_URL: use NEXT_PUBLIC_CONVEX_URL
# OPENAI_API_KEY: use LLM_API_KEY
# QA_MAX_FIX_ITERATIONS: use ORCHESTRATOR_QA_MAX_FIX_ITERATIONS
# QA_REQUIRED: use ORCHESTRATOR_QA_REQUIRED
# ORCHESTRATOR_RUNTIME: use ORCHESTRATOR_EXECUTION_RUNTIME
# QA_SERVER_START_TIMEOUT_MS: use QA_STARTUP_TIMEOUT_MS
