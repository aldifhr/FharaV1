{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/.moagent-worktrees/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["electron/main.cjs", "electron/preload.cjs", "scripts/*.mjs"],
      "project": ["electron/**/*.cjs", "scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,route,loading,error,global-error,not-found,template,default}.{ts,tsx}",
        "tests/bench/*.bench.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs}"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    },
    "apps/api": {
      "entry": ["convex/**/*.ts"],
      "project": ["convex/**/*.ts"],
      "ignoreDependencies": ["vite"]
    },
    "packages/worker": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/shared": {
      // Loaded by path as a Vitest setup file by the unported client-runtime.
      "entry": ["src/testing/providerEnv.ts"]
    },
    "packages/contracts": {
      // Duplicate exports retained verbatim from FharaV2; upstream knip
      // reports the same four files, so they are not new to this port.
      "ignoreIssues": {
        "src/checkpointDiff.ts": ["duplicates"],
        "src/orchestratorMcp.ts": ["duplicates"],
        "src/server.ts": ["duplicates"],
        "src/terminal.ts": ["duplicates"]
      }
    }
  }
}
