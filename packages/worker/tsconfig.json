{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/api/*": ["../../apps/api/*"],
      "@api/*": ["../../apps/api/*"],
      "@/*": ["./src/*"]
    },
    "types": ["node", "vitest/globals"],
    "rootDir": "../..",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "tests/**/*", "live-browser-smoke.ts"],
  "exclude": ["node_modules"]
}
