NEXT_PUBLIC_CONVEX_URL=
CONVEX_SERVICE_TOKEN=
ANTHROPIC_API_KEY=
WORKER_POLL_INTERVAL_MS=2000
WORKSPACE_ROOT=./workspaces
# Execution runtime: "api" (agent LLM + MOAgent host tools, gated) or
# "native-provider" (provider CLI runs its own tools in the workspace;
# full-access per plans/014-provider-native-runtime.md).
ORCHESTRATOR_RUNTIME=api
# Native-provider CLI binary (default opencode).
ORCHESTRATOR_NATIVE_PROVIDER_COMMAND=opencode

# Browser QA (worker). Default mode is auto: QA runs for applied UI changes
# (or when the user asks for QA/e2e) in a browser-runnable project.
# Install Chromium once: cd packages/worker && npx playwright install chromium
ORCHESTRATOR_QA_MODE=auto
# ORCHESTRATOR_QA_MAX_FIX_ITERATIONS=1
# ORCHESTRATOR_QA_REQUIRED=0        # 1 = environment-blocked QA fails the task
# QA_STARTUP_TIMEOUT_MS=90000        # dev-server startup wait
# QA_CHROMIUM_PATH=                  # system Chromium (e.g. linux-arm64), fallback PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH
# QA_CHROMIUM_NO_SANDBOX=            # 1 = add --no-sandbox (auto when root / in a container)
