{
  "name": "@fhara/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Fhara's single env schema: every var, its runtimes, type, default, secret flag and aliases, plus the per-runtime readers. Zero dependencies, no node: imports.",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/runtime/worker.ts",
    "./convex": "./src/runtime/convex.ts",
    "./web-server": "./src/runtime/webServer.ts",
    "./web-client": "./src/runtime/webClient.ts",
    "./env-manifest.json": "./env-manifest.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "env:example": "tsx scripts/gen-env.ts"
  }
}
