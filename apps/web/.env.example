# Next.js web app — cp apps/web/.env.example apps/web/.env.local
# Same Convex URL as NEXT_PUBLIC_CONVEX_URL in the root .env.
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL for the GitHub OAuth callback route
# (/api/integrations/github/callback). Default: .convex.cloud → .convex.site,
# or for a local backend the API port + 1. Set it when the site proxy runs on
# another port.
# CONVEX_SITE_URL=
